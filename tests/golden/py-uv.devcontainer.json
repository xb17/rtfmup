{
  "name": "py-uv (rtfmup)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "pip install uv && uv sync",
  "customizations": {
    "rtfmup": {
      "notes": [
        "uv is installed with pip because no official Feature provides it.",
        "Start the app with: uv run py-uv-fixture"
      ]
    }
  }
}
